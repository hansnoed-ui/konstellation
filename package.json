{
  "name": "konstellation",
  "version": "0.3.1",
  "private": true,
  "description": "KONSTELLATION – zweistufige, deterministische Auswahl aus Wetter, Exoplanet, Kunstbild und Textstelle",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "verify": "node tools/verify-catalog.js",
    "import:exoplanets": "node importers/import-exoplanets.js",
    "import:images:met": "node importers/import-images-met.js",
    "import:images:si": "node importers/import-images-smithsonian.js",
    "import:texts:eltec": "node importers/import-texts-eltec.js",
    "import:weather-archive": "node importers/import-weather-archive.js",
    "import:basemap": "node importers/import-basemap.js",
    "import:gutenberg-index": "node importers/import-gutenberg-index.js",
    "example": "node tools/example-run.js",
    "build:static": "node tools/build-static.js dist/static",
    "test:ui": "node test/ui.e2e.mjs"
  }
}
